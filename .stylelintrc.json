{
  "extends": "stylelint-config-standard",
  "rules": {
    "selector-class-pattern": [
      "^([a-z][a-zA-Z0-9]*|([a-z][a-z0-9-]*)(__[a-z0-9-]+)?(--[a-z0-9-]+)?|([a-z][a-z0-9]*)(-[a-z0-9]+)*)$",
      {
        "message": "Используйте camelCase, kebab-case или BEM (block, block__element, block--modifier)"
      }
    ],
    "keyframes-name-pattern": [
      "^([a-z][a-zA-Z0-9]*|([a-z][a-z0-9]*)(-[a-z0-9]+)*)$",
      {
        "message": "Используйте camelCase или kebab-case для имен анимаций"
      }
    ],
    "color-function-notation": null,
    "alpha-value-notation": null,
    "media-feature-range-notation": null,
    "number-max-precision": null,
    "no-descending-specificity": null,
    "declaration-block-single-line-max-declarations": null,
    "property-no-vendor-prefix": null,
    "declaration-property-value-no-unknown": [
      true,
      {
        "ignoreProperties": {
          "/^-webkit-/": "/.*/"
        }
      }
    ],
    "value-keyword-case": null,
    "color-function-alias-notation": null
  }
}

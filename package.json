{
  "name": "my-website",
  "version": "1.0.0",
  "description": "Corporate website with clean, maintainable structure and optimized CSS.",
  "homepage": "https://nikolai-pir-s-ru.sourcecraft.site/portfolio/my-website",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikolai-karpov/my-website.git"
  },
  "bugs": {
    "url": "https://github.com/nikolai-karpov/my-website/issues"
  },
  "keywords": [
    "website",
    "corporate",
    "static",
    "css",
    "purgecss",
    "github-pages"
  ],
  "author": "Nikolai Karpov",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "sass:build": "sass assets/scss/main.scss:assets/css/main.css --style=compressed",
    "sass:watch": "sass assets/scss/main.scss:assets/css/main.css --watch --style=expanded",
    "purge:css": "node purge.js",
    "build": "npm run sass:build && npm run purge:css",
    "prebuild": "echo '🚀 Запуск сборки...' && mkdir -p assets/css",
    "postbuild": "echo '✅ Сборка завершена. Проверьте assets/css/main.css'",
    "lint:css": "stylelint legacy/assets/scss/**/*.scss",
    "lint:css:fix": "stylelint legacy/assets/scss/**/*.scss --fix",
    "prepare": "husky",
    "dev": "concurrently \"npm run sass:watch\" \"live-server --port=8080 --open=/index.html\"",
    "serve": "live-server --port=8080 --open=/index.html",
    "alt:rebuild": "rm -rf alt/notebook alt/qwen && mkdir -p alt/notebook alt/qwen && git archive origin/notebook | tar -x -C alt/notebook && git archive origin/qwen-code-be4f133a-9ccd-47aa-84f7-9e809dfd111e | tar -x -C alt/qwen && node scripts/patch-alt-snapshots.mjs",
    "precommit": "lint-staged",
    "test": "echo 'Tests are not configured for this project'"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "live-server": "^1.2.2",
    "postcss-scss": "^4.0.9",
    "purgecss": "^7.0.2",
    "sass": "^1.94.1",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-scss": "^6.12.1"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "lint-staged": {
    "*.scss": [
      "stylelint --fix"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
